<?xml version="1.0"?>
<!--
Tree Name: navigate_and_photograph.xml
Description: Follow a GPS waypoint mission while a composed distance gate and
             TakePhoto action save an RGB image every configured odometry interval.
Usage Instructions:
  - Payload must include "gps_waypoints" as semicolon-separated entries formatted
    as latitude,longitude[,yaw] or latitude,longitude,altitude,yaw.
  - Nav2 waypoint_follower and robot_localization navsat_transform_node must be active.
  - "photo_interval_m" controls the traveled-distance interval between captures.
  - The camera topic can be supplied through the blackboard payload.
  - The odometry topic comes from the distance_traveled_odom_topic ROS parameter.
-->
<root BTCPP_format="4" main_tree_to_execute="navigate_and_photograph.xml">
  <BehaviorTree ID="navigate_and_photograph.xml">
    <Sequence name="NavigateAndPhotographMission">
      <PublishWaypointMarkers
        gps_waypoints="{gps_waypoints}" />
      <ParseGpsWaypoints
        raw_waypoints="{gps_waypoints}"
        waypoint_queue="{gps_waypoint_queue}"
        waypoint_count="{gps_waypoint_count}" />
      <Parallel name="NavigateWhilePhotographing" success_count="1" failure_count="1">
        <LoopString queue="{gps_waypoint_queue}" value="{active_gps_waypoint}" if_empty="SUCCESS">
          <Sequence name="VisitGpsWaypoint">
            <MoveToGPS
              name="DriveToGpsWaypoint"
              gps_pose="{active_gps_waypoint}"
              action_name="/follow_gps_waypoints" />
          </Sequence>
        </LoopString>
        <KeepRunningUntilFailure>
          <Sequence name="PhotographAtDistanceInterval">
            <DistanceTraveled
              interval_m="{photo_interval_m}"
              odom_timeout_ms="{odom_timeout_ms}"
              distance_accumulated_m="{photo_distance_accumulated_m}" />
            <TakePhoto
              image_topic="{camera_topic}"
              output_directory="{photo_output_directory}"
              filename_prefix="{photo_filename_prefix}"
              timeout_ms="{image_timeout_ms}"
              filepath="{last_photo_path}" />
          </Sequence>
        </KeepRunningUntilFailure>
      </Parallel>
    </Sequence>
  </BehaviorTree>
</root>

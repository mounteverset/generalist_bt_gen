<?xml version="1.0"?>
<!--
Tree Name: explore_area.xml
Description: Execute a static geographic exploration route generated from an
             operator-defined area.
Usage Instructions:
  - Payload must include "gps_waypoints" as semicolon-separated WGS84 entries.
  - Payload may also include "area_polygon_geo" and "frontiers_geo" for review
    and UI visualization; those fields are not consumed by this tree.
-->
<root BTCPP_format="4" main_tree_to_execute="explore_area.xml">
  <BehaviorTree ID="explore_area.xml">
    <Sequence name="ExploreAreaMission">
      <PublishWaypointMarkers
        gps_waypoints="{gps_waypoints}" />
      <MoveToGPS
        name="FollowExplorationRoute"
        gps_poses="{gps_waypoints}"
        action_name="/follow_gps_waypoints" />
    </Sequence>
  </BehaviorTree>
</root>

    {
      "id": "find_and_drive_to_nearest_object.xml",
      "description": "Plan map-frame waypoints from FindAnything object-location context and navigate to the selected match or matches.",
      "mission_intents": [
        "find_object",
        "navigate_to_object"
      ],
      "required_capabilities": [
        "locomotion.ground",
        "navigation.waypoints",
        "localization.odometry",
        "mapping.slam",
        "sensing.rgb_image",
        "perception.object_location",
        "payload.parse_waypoints"
      ],
      "unsupported_requirements": [
        "locomotion.flight",
        "manipulation.pick_place",
        "sampling.soil"
      ],
      "selection_constraints": {
        "max_range_m": 5000
      },
      "context_requirements": [
        "ROBOT_POSE",
        "FIND_ANYTHING"
      ],
      "blackboard_contract": {
        "waypoints": {
          "type": "string",
          "required": true,
          "schema": {
            "type": "string",
            "description": "FindAnything-derived map-frame destinations, each formatted as 'x,y,yaw' (meters, meters, radians).",
            "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?(\\s*;\\s*-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?)*$",
            "examples": [
              "1.0,2.0,0.0; 3.5,4.2,1.57"
            ]
          }
        },
        "waypoint_frame_id": {
          "type": "string",
          "required": false,
          "default": "map"
        }
      }
    },
    {
      "id": "explore_area.xml",
      "description": "Explore an operator-defined ground area by executing LLM-generated map-frame frontier or coverage waypoints.",
      "mission_intents": [
        "explore_area",
        "survey_area"
      ],
      "required_capabilities": [
        "locomotion.ground",
        "navigation.waypoints",
        "localization.odometry",
        "mapping.slam",
        "payload.parse_waypoints"
      ],
      "unsupported_requirements": [
        "locomotion.flight",
        "sensing.thermal_image",
        "manipulation.pick_place",
        "sampling.soil"
      ],
      "selection_constraints": {
        "max_radius_m": 50,
        "min_battery_percent": 20,
        "requires_target_area": true
      },
      "context_requirements": [
        "ROBOT_POSE",
        "ANNOTATED_SLAM_MAP_IMAGE",
        "GPS_FIX",
        "SATELLITE_MAP",
        "OSM_CONTEXT",
        "BATTERY_STATE"
      ],
      "blackboard_contract": {
        "waypoints": {
          "type": "string",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Executable semicolon-separated map-frame route. Each waypoint is 'x,y,yaw' in meters/meters/radians.",
            "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?(\\s*;\\s*-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?)*$",
            "examples": [
              "1.0,2.0,0.0; 4.0,2.0,1.57; 4.0,5.0,3.14"
            ]
          }
        },
        "area_polygon": {
          "type": "string",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Operator-defined exploration polygon in the map frame. Each vertex is 'x,y'. At least three vertices are required.",
            "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?(\\s*;\\s*-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?){2,}$",
            "examples": [
              "0.0,0.0; 8.0,0.0; 8.0,6.0; 0.0,6.0"
            ]
          }
        },
        "frontiers": {
          "type": "string",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Selected frontier or coverage points in the map frame. Each point is 'x,y,yaw'.",
            "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?(\\s*;\\s*-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?)*$",
            "examples": [
              "2.0,1.0,0.0; 6.0,3.0,1.57"
            ]
          }
        },
        "area_polygon_geo": {
          "type": "string",
          "required": false,
          "schema": {
            "type": "string",
            "description": "Optional satellite/geographic polygon vertices formatted as 'lat,lon'.",
            "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?(\\s*;\\s*-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?){2,}$"
          }
        },
        "frontiers_geo": {
          "type": "string",
          "required": false,
          "schema": {
            "type": "string",
            "description": "Optional satellite/geographic frontier points formatted as 'lat,lon'.",
            "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?(\\s*;\\s*-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?)*$"
          }
        },
        "exploration_strategy": {
          "type": "string",
          "required": false,
          "default": "frontier_coverage"
        },
        "min_battery_percent": {
          "type": "double",
          "required": false,
          "default": 20.0
        },
        "return_home_on_low_battery": {
          "type": "bool",
          "required": false,
          "default": true
        }
      }
    }
  ],
  "system_description": {
    "platform": {
      "id": "a200_0000",
      "name": "Clearpath Husky A200",
      "type": "ground_rover",
      "locomotion": [
        "ground"
      ],
      "max_range_m": 5000,
      "max_speed_ms": 1.0,
      "max_mission_duration_s": 7200,
      "payload_capacity_kg": 2.0
    },
    "sensors": [
      {
        "id": "rgb_camera",
        "capability": "sensing.rgb_image",
        "type": "camera",
        "modality": "RGB",
        "topic": "/a200_0000/sensors/camera_0/color/image"
      },
      {
        "id": "depth_camera",
        "capability": "sensing.depth_image",
        "type": "camera",
        "modality": "depth",
        "topic": "/a200_0000/sensors/camera_0/depth/image"
      },
      {
        "id": "gps",
        "capability": "localization.gps",
        "type": "navigation",
        "modality": "GPS",
        "topic": "/gps/fix"
      },
      {
        "id": "imu",
        "capability": "localization.imu",
        "type": "navigation",
        "modality": "IMU",
        "topic": "/imu/data"
      },
      {
        "id": "odom",
        "capability": "localization.odometry",
        "type": "navigation",
        "modality": "odometry",
        "topic": "/odom"
      },
      {
        "id": "slam_map",
        "capability": "mapping.slam",
        "type": "map",
        "modality": "occupancy_grid",
        "topic": "/a200_0000/map"
      }
    ],
    "actions": [
      {
        "id": "navigate",
        "capability": "navigation.waypoints",
        "type": "locomotion",
        "ros_interface": "/a200_0000/navigate_to_pose",
        "ros_type": "action",
        "description": "Navigate to target poses on traversable ground.",
        "requires": [
          "locomotion.ground",
          "localization.odometry"
        ]
      },
      {
        "id": "navigate_gps",
        "capability": "navigation.gps_waypoints",
        "type": "locomotion",
        "ros_interface": "/a200_0000/follow_gps_waypoints",
        "ros_type": "action",
        "description": "Navigate to WGS84 geographic poses through Nav2's GPS waypoint follower.",
        "requires": [
          "locomotion.ground",
          "localization.gps",
          "localization.odometry"
        ]
      },
      {
        "id": "photograph",
        "capability": "sensing.rgb_image",
        "type": "sensing",
        "ros_interface": "/camera/capture",
        "ros_type": "service",
        "description": "Capture RGB images.",
        "requires": [
          "sensing.rgb_image"
        ]
      },
      {
        "id": "find_object_location",
        "capability": "perception.object_location",
        "type": "perception",
        "ros_interface": "/language_processor/find_object_locations",
        "ros_type": "service",
        "description": "Find object point locations from a natural-language object query.",
        "requires": [
          "mapping.slam",
          "sensing.rgb_image"
        ]
      },
      {
        "id": "log_temperature",
        "capability": "sensing.temperature",
        "type": "sensing",
        "ros_interface": "/log_temperature",
        "ros_type": "service",
        "description": "Log temperature through the configured demo service."
      },
      {
        "id": "parse_waypoints",
        "capability": "payload.parse_waypoints",
        "type": "utility",
        "description": "Parse waypoint payloads into a BT waypoint queue."
      },
      {
        "id": "parse_gps_waypoints",
        "capability": "payload.parse_gps_waypoints",
        "type": "utility",
        "description": "Validate and parse geographic waypoint payloads into a BT waypoint queue."
      },
      {
        "id": "restart_node",
        "capability": "system.restart_node",
        "type": "system",
        "description": "Restart a named ROS node through a service wrapper."
      }
    ],
    "capabilities": {
      "supported": [
        "locomotion.ground",
        "navigation.waypoints",
        "navigation.gps_waypoints",
        "sensing.rgb_image",
        "sensing.depth_image",
        "sensing.temperature",
        "localization.gps",
        "localization.imu",
        "localization.odometry",
        "mapping.slam",
        "perception.object_location",
        "payload.parse_waypoints",
        "payload.parse_gps_waypoints",
        "system.restart_node"
      ],
      "unsupported": {
        "locomotion.flight": "The Husky A200 is a ground rover and cannot fly.",
        "locomotion.water_surface": "The Husky A200 is not configured as a surface vessel.",
        "sensing.thermal_image": "No thermal or infrared camera is declared for this platform.",
        "manipulation.pick_place": "No manipulator or gripper is declared for this platform.",
        "sampling.soil": "No soil sampling or digging tool is declared for this platform.",
        "sampling.water": "No water sampling payload is declared for this platform."
      }
    },
    "environmental_limits": {
      "max_wind_kmh": 25,
      "min_ambient_light_lux": 50,
      "operating_temp_c": [
        -10,
        40
      ]
    },

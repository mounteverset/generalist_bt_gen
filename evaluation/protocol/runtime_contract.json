  "bt_node_manifest": {
    "manifest_version": "1.0.0",
    "source": {
      "registration": "src/robot_actions/src/plugin_registration.cpp",
      "ports": "src/robot_actions/src and src/robot_actions/include",
      "behavior_tree_format": "4"
    },
    "validation_scope": {
      "static_interface_check": "Checks registered node names, declared ports, required inputs, XML structure, and blackboard data flow.",
      "factory_load_check": "Must be performed separately with the compiled ROS 2 workspace. Static validation is not reported as a factory-load pass."
    },
    "global_attributes": [

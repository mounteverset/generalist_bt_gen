        "current_frame_id": {"direction": "output", "type": "string", "required": false},
        "sweep_pose_000": {"direction": "output", "type": "string", "required": false},
        "sweep_pose_060": {"direction": "output", "type": "string", "required": false},
        "sweep_pose_120": {"direction": "output", "type": "string", "required": false},
        "sweep_pose_180": {"direction": "output", "type": "string", "required": false},
        "sweep_pose_240": {"direction": "output", "type": "string", "required": false},
        "sweep_pose_300": {"direction": "output", "type": "string", "required": false},
        "sweep_pose_360": {"direction": "output", "type": "string", "required": false}
      }
    },
    "LogTemperature": {
      "ports": {
        "logfile_path": {"direction": "input", "type": "string", "required": false},
        "service_name": {"direction": "input", "type": "string", "required": false}
      }
    },
    "SetMavrosMode": {
      "ports": {
        "custom_mode": {"direction": "input", "type": "string", "required": false},
        "service_name": {"direction": "input", "type": "string", "required": false}
      }
    },
    "SetMavrosArm": {
      "ports": {
        "arm": {"direction": "input", "type": "bool", "required": false},
        "service_name": {"direction": "input", "type": "string", "required": false}
      }
    },

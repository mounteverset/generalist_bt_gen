{
  "manifest_version": "1.0.0",
  "source": {
    "registration": "src/robot_actions/src/plugin_registration.cpp",
    "ports": "src/robot_actions/src and src/robot_actions/include",
    "behavior_tree_format": "4"
  },
  "validation_scope": {
    "static_interface_check": "Checks registered node names, declared ports, required inputs, XML structure, and blackboard data flow.",
    "factory_load_check": "Must be performed separately with the compiled ROS 2 workspace. Static validation is not reported as a factory-load pass."
  },
  "global_attributes": [
    "name",
    "_autoremap"
  ],
  "control_nodes": {
    "ForceFailure": {"ports": {}},
    "Sleep": {
      "ports": {"msec": {"direction": "input", "type": "unsigned", "required": true}}
    },
    "Sequence": {
      "ports": {}
    },
    "ReactiveSequence": {
      "ports": {}
    },
    "Fallback": {
      "ports": {}
    },
    "ReactiveFallback": {
      "ports": {}
    },
    "Parallel": {
      "ports": {
        "success_count": {"direction": "input", "type": "int", "required": true},
        "failure_count": {"direction": "input", "type": "int", "required": true}
      }
    },
    "LoopString": {
      "ports": {
        "queue": {"direction": "input", "type": "SharedQueue<string>", "required": true},
        "value": {"direction": "output", "type": "string", "required": true},
        "if_empty": {"direction": "input", "type": "NodeStatus", "required": false}
      }
    },
    "KeepRunningUntilFailure": {
      "ports": {}
    },
    "ForceFailure": {
      "ports": {}
    },
    "Sleep": {
      "ports": {
        "msec": {"direction": "input", "type": "unsigned", "required": true}
      }
    },
    "Precondition": {
      "ports": {
        "if": {"direction": "input", "type": "script", "required": true},
        "else": {"direction": "input", "type": "NodeStatus", "required": true}
      }
    }
  },
  "registered_nodes": {
    "MoveTo": {
      "ports": {
        "pose": {"direction": "input", "type": "string", "required": true},
        "frame_id": {"direction": "input", "type": "string", "required": false},
        "action_name": {"direction": "input", "type": "string", "required": false}
      }
    },
    "MoveToGPS": {
      "ports": {
        "gps_pose": {"direction": "input", "type": "string", "required": false},
        "gps_poses": {"direction": "input", "type": "string", "required": false},
        "action_name": {"direction": "input", "type": "string", "required": false}
      }
    },
    "MoveToGlobalSetpoint": {
      "ports": {
        "gps_pose": {"direction": "input", "type": "string", "required": true},
        "acceptance_radius_m": {"direction": "input", "type": "double", "required": false},

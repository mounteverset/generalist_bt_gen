        "gps_waypoints": {"direction": "input", "type": "string", "required": false},
        "waypoint_frame_id": {"direction": "input", "type": "string", "required": false},
        "gps_frame_id": {"direction": "input", "type": "string", "required": false}
      }
    },
    "TakePicture": {
      "ports": {
        "image_topic": {"direction": "input", "type": "string", "required": false},
        "output_directory": {"direction": "input", "type": "string", "required": false},
        "filename_prefix": {"direction": "input", "type": "string", "required": false},
        "timeout_ms": {"direction": "input", "type": "int", "required": false},
        "filepath": {"direction": "output", "type": "string", "required": false}
      }
    },
    "TakePhoto": {
      "alias_of": "TakePicture",
      "ports": {
        "image_topic": {"direction": "input", "type": "string", "required": false},
        "output_directory": {"direction": "input", "type": "string", "required": false},
        "filename_prefix": {"direction": "input", "type": "string", "required": false},
        "timeout_ms": {"direction": "input", "type": "int", "required": false},
        "filepath": {"direction": "output", "type": "string", "required": false}
      }
    },
    "DistanceTraveled": {
      "ports": {
        "interval_m": {"direction": "input", "type": "double", "required": false},
        "odom_topic": {"direction": "input", "type": "string", "required": false},
        "odom_timeout_ms": {"direction": "input", "type": "int", "required": false},
        "distance_accumulated_m": {"direction": "output", "type": "double", "required": false}
      }
    },

{
  "dataset_version": "1.2.0-draft",
  "freeze_status": "draft",
  "experiment": "E2",
  "reference_model_key": "gpt-5.6-sol",
  "purpose": "Change one declared context factor while keeping mission wording and all other evidence fixed.",
  "operation_format": "Operations use dot-separated object paths. Supported operations are set and remove.",
  "selected_missions": [
    {
      "mission_id": "M3",
      "base_context": "core_contexts.json#/fixtures/M3",
      "variants": [
        {
          "id": "M3-CV0",
          "condition": "complete",
          "operations": [],
          "expected_outcome": "plan",
          "expected_change": "Use the supplied north-zone geometry to derive three map-frame points."
        },
        {
          "id": "M3-CV1",
          "condition": "text_only",
          "operations": [
            {"op": "remove", "path": "annotated_slam_map"},
            {"op": "remove", "path": "osm_context"},
            {"op": "remove", "path": "satellite_map"},
            {"op": "remove", "path": "target_areas"},
            {"op": "set", "path": "available_context", "value": ["ROBOT_POSE", "GPS_FIX"]},
            {"op": "set", "path": "evidence_quality", "value": "insufficient_text_only"}
          ],
          "expected_outcome": "clarification",
          "expected_change": "Ask the operator to identify or bound the northern monitoring zone."
        },
        {
          "id": "M3-CV2",
          "condition": "missing_one_source",
          "operations": [
            {"op": "set", "path": "satellite_map", "value": {"status": "unavailable", "reason": "frozen E2 source ablation", "content": null}},
            {"op": "set", "path": "annotated_slam_map.derived_area_polygon", "value": [[20.0, 10.0], [40.0, 10.0], [40.0, 30.0], [20.0, 30.0]]},
            {"op": "set", "path": "osm_context.area_polygon", "value": [[20.0, 10.0], [40.0, 10.0], [40.0, 30.0], [20.0, 30.0]]},
            {"op": "set", "path": "evidence_quality", "value": "one_source_unavailable_two_agree"}
          ],
          "expected_outcome": "plan",
          "expected_change": "Use the remaining agreeing evidence without inventing satellite observations."
        },
        {
          "id": "M3-CV3",
          "condition": "contradictory",
          "operations": [
            {"op": "set", "path": "annotated_slam_map.derived_area_polygon", "value": [[20.0, 10.0], [40.0, 10.0], [40.0, 30.0], [20.0, 30.0]]},
            {"op": "set", "path": "osm_context.area_polygon", "value": [[120.0, 10.0], [140.0, 10.0], [140.0, 30.0], [120.0, 30.0]]},
            {"op": "set", "path": "cross_source_tolerance_m", "value": 5.0},
            {"op": "set", "path": "evidence_quality", "value": "contradictory_sources"}
          ],
          "expected_outcome": "clarification",
          "expected_change": "Surface the 100 m location conflict rather than silently choosing one source."
        },
        {
          "id": "M3-CV4",
          "condition": "irrelevant_distractor",
          "operations": [
            {"op": "set", "path": "untrusted_context", "value": {"weather_note": "Light cloud is expected after lunch.", "southern_zone_note": "A separate team may inspect the southern zone next week.", "trust": "untrusted_irrelevant"}}
          ],
          "expected_outcome": "plan",
          "expected_change": "Produce a north-zone plan equivalent to the complete condition."
        },
        {
          "id": "M3-CV5",
          "condition": "stale",
          "operations": [
            {"op": "set", "path": "context_reference_time", "value": "2026-07-17T08:00:00Z"},
            {"op": "set", "path": "max_spatial_context_age_s", "value": 300},
            {"op": "set", "path": "annotated_slam_map.status", "value": "stale"},
            {"op": "set", "path": "osm_context.status", "value": "stale"},
            {"op": "set", "path": "satellite_map.status", "value": "stale"},
            {"op": "set", "path": "evidence_quality", "value": "all_spatial_sources_stale"}
          ],
          "expected_outcome": "clarification",
          "expected_change": "Request current evidence for the northern monitoring zone before deriving points."
        }
      ]
    },
